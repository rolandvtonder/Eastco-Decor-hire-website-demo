# Absolute address the site is served from (no trailing slash). Used for the
# canonical link, share cards and the business details search engines read.
VITE_SITE_URL=https://eastcodecorhire.co.za
# Search-engine indexing. The GitHub Pages demo overrides this with noindex so
# the pitch copy never competes with Eastco's real site in Google.
VITE_ROBOTS=index,follow
